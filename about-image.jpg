<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 300" width="400" height="300">
  <defs>
    <linearGradient id="buildingGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#e3f2fd;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#bbdefb;stop-opacity:1" />
    </linearGradient>
  </defs>
  <!-- Background -->
  <rect width="400" height="300" fill="#f5f5f5"/>
  <!-- Buildings -->
  <rect x="50" y="150" width="40" height="100" fill="url(#buildingGrad)" stroke="#1976d2" stroke-width="1"/>
  <rect x="110" y="120" width="40" height="130" fill="url(#buildingGrad)" stroke="#1976d2" stroke-width="1"/>
  <rect x="170" y="100" width="40" height="150" fill="url(#buildingGrad)" stroke="#1976d2" stroke-width="1"/>
  <rect x="230" y="140" width="40" height="110" fill="url(#buildingGrad)" stroke="#1976d2" stroke-width="1"/>
  <!-- Windows -->
  <rect x="55" y="160" width="8" height="8" fill="#42a5f5"/>
  <rect x="70" y="160" width="8" height="8" fill="#42a5f5"/>
  <rect x="55" y="180" width="8" height="8" fill="#42a5f5"/>
  <rect x="70" y="180" width="8" height="8" fill="#42a5f5"/>
  <!-- People -->
  <circle cx="180" cy="220" r="8" fill="#ff9800"/>
  <rect x="175" y="228" width="10" height="20" fill="#ff9800"/>
  <circle cx="220" cy="230" r="6" fill="#4caf50"/>
  <rect x="217" y="236" width="6" height="15" fill="#4caf50"/>
  <!-- Text -->
  <text x="200" y="280" text-anchor="middle" font-family="Arial" font-size="14" fill="#666">Rural Studio Architecture</text>
</svg>